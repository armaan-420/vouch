#!/bin/sh
# Sync completed main-branch commits from this checkout. Never force-push.
[ "${VOUCH_SKIP_AUTO_SYNC:-0}" = "1" ] && exit 0
[ "$(git symbolic-ref --quiet --short HEAD)" = "main" ] || exit 0
[ "$(git remote get-url --push github 2>/dev/null)" = "https://github.com/armaan-420/vouch.git" ] || {
  echo "Vouch: automatic sync skipped because the GitHub remote does not match." >&2
  exit 0
}
if ! GIT_TERMINAL_PROMPT=0 git push github HEAD:refs/heads/main; then
  echo "Vouch: commit saved locally, but GitHub sync failed. Retry git push github main after resolving access/network or remote changes. No force push was attempted." >&2
fi
